# ───────────── Aplicação ─────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=contato@seudominio.com.br

# ───────────── Supabase ─────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA exponha esta chave no navegador. Usada só no servidor (webhook, PDF, admin).
SUPABASE_SERVICE_ROLE_KEY=

# ───────────── Inteligência artificial ─────────────
# anthropic | openai-compatible
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
# Opcional. Obrigatório para openai-compatible (ex.: https://api.openai.com/v1)
AI_BASE_URL=
# Limite de chamadas de IA por usuário a cada hora
AI_RATE_LIMIT_PER_HOUR=20

# ───────────── Mercado Pago ─────────────
# Token de PRODUÇÃO (APP_USR-...) em produção; token de teste só em sandbox.
MERCADOPAGO_ACCESS_TOKEN=
# "Assinatura secreta" do webhook (Suas integrações > Webhooks). Obrigatória em produção.
MERCADOPAGO_WEBHOOK_SECRET=
# Minutos até a cobrança Pix expirar
PIX_EXPIRATION_MINUTES=30

# ───────────── Jobs agendados ─────────────
# Segredo do cron de retenção (Vercel envia como Bearer)
CRON_SECRET=
